{
  "rules": {
    ".read": true,

    "apps": {
      ".write": "auth != null && (auth.token.email === 'owner@sgstore.eg' || auth.token.email === 'admin@sgstore.eg')"
    },

    "mods": {
      ".write": "auth != null && (auth.token.email === 'owner@sgstore.eg' || auth.token.email === 'admin@sgstore.eg')"
    },

    "notifs": {
      ".write": "auth != null && (auth.token.email === 'owner@sgstore.eg' || auth.token.email === 'admin@sgstore.eg')"
    },

    "settings": {
      ".write": "auth != null && (auth.token.email === 'owner@sgstore.eg' || auth.token.email === 'admin@sgstore.eg')"
    },

    "users": {
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || auth.token.email === 'owner@sgstore.eg' || auth.token.email === 'admin@sgstore.eg')"
      }
    }
  }
}
